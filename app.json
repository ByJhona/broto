{
  "expo": {
    "name": "Muda Vai Vem",
    "slug": "broto",
    "version": "1.0.49",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "com.byjhona.broto",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#455F40",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.byjhona.broto",
      "versionCode": 57,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#455F40"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF5EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0F140F",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Muda Vai Vem usa suas fotos para você adicionar uma imagem da sua planta."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Muda Vai Vem usa a câmera para você fotografar suas plantas.",
          "microphonePermission": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Muda Vai Vem usa sua localização pra mostrar plantas disponíveis perto de você no mapa."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-localization",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyAOQrkIVt9BM9Qw7Z7iggtmO0Wcdn_UoAE"
        }
      ],
      "expo-calendar",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Figtree",
                "fontDefinitions": [
                  { "path": "./node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf", "weight": 400 },
                  { "path": "./node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf", "weight": 500 },
                  { "path": "./node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf", "weight": 600 },
                  { "path": "./node_modules/@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "Bricolage Grotesque",
                "fontDefinitions": [
                  { "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/500Medium/BricolageGrotesque_500Medium.ttf", "weight": 500 },
                  { "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/600SemiBold/BricolageGrotesque_600SemiBold.ttf", "weight": 600 },
                  { "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf", "weight": 700 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
              "./node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
              "./node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf",
              "./node_modules/@expo-google-fonts/bricolage-grotesque/500Medium/BricolageGrotesque_500Medium.ttf",
              "./node_modules/@expo-google-fonts/bricolage-grotesque/600SemiBold/BricolageGrotesque_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e55984d0-bebe-4ae4-a7b0-1ad075624206"
      }
    }
  }
}
